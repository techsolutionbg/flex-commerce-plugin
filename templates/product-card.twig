{% set image = product.images|first %}<article class="commerce-product-card"><div class="commerce-card-media"><a class="commerce-card-image" href="/product/{{ product.slug|url_encode }}" tabindex="-1" aria-hidden="true">{% if image %}<img src="{{ image.thumbnail_url ?: image.url }}" alt="" loading="lazy" decoding="async" width="400" height="400">{% else %}<span class="commerce-image-placeholder">Няма изображение</span>{% endif %}</a><button type="button" class="commerce-card-favorite" disabled data-commerce-favorite="{{ product.id }}" data-product-name="{{ product.name }}" aria-pressed="false" aria-label="Добави {{ product.name }} към любими" title="Добави към любими"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/></svg></button></div><div class="commerce-card-details"><h2><a href="/product/{{ product.slug|url_encode }}">{{ product.name }}</a></h2>{% if product.excerpt %}<p class="commerce-card-excerpt">{{ product.excerpt }}</p>{% endif %}{% if not product.available %}<span class="commerce-stock">Изчерпан</span>{% endif %}<div class="commerce-price{{ product.on_sale|default(false) ? ' commerce-price--sale' : '' }}">{% if product.on_sale|default(false) %}<div class="commerce-price-meta"><del class="commerce-regular-price" aria-label="Редовна цена">{{ product.regular_price }} <span class="commerce-price-currency">{{ product.currency }}</span></del><span class="commerce-sale-badge">−{{ product.discount_percent }}%</span></div><ins class="commerce-sale-price" aria-label="Промоционална цена">{{ product.price }} <span class="commerce-price-currency">{{ product.currency }}</span></ins>{% else %}{{ product.price }} <span class="commerce-price-currency">{{ product.currency }}</span>{% endif %}</div><div class="commerce-card-actions"><button type="button" class="commerce-card-add" disabled data-commerce-cart-add="{{ product.id }}" data-available="{{ product.available ? '1' : '0' }}" aria-label="Добави {{ product.name }} в количката" title="Добави в количката"><span class="commerce-add-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 7h14l1 14H4L5 7Z"/><path d="M9 7V5a3 3 0 0 1 6 0v2M9 14h6M12 11v6"/></svg></span><span class="commerce-card-action-label" data-commerce-cart-label>Добавяне в количката</span></button><button type="button" class="commerce-card-quick-order" disabled data-commerce-cart-add="{{ product.id }}" data-available="{{ product.available ? '1' : '0' }}" data-commerce-redirect="/cart" aria-label="Бърза поръчка: {{ product.name }}" title="Бърза поръчка"><span class="commerce-quick-order-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/></svg></span><span class="commerce-card-action-label" data-commerce-cart-label>Бърза поръчка</span></button><button type="button" class="commerce-quick-view-button" data-commerce-preview="{{ product.slug }}" aria-label="Бърз преглед: {{ product.name }}" title="Бърз преглед"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></button></div></div></article>
