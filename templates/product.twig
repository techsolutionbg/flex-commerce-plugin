{% if not quick_view|default(false) %}<nav class="commerce-breadcrumbs" aria-label="Път до страницата"><a href="/">Начало</a><span aria-hidden="true">/</span><a href="/catalog">Продукти</a><span aria-hidden="true">/</span><span>{{ product.name }}</span></nav>{% endif %}
<div class="commerce-product-detail{{ product_page_layout|default('plain') == 'boxed' ? ' commerce-product-layout--boxed' : '' }}">
<div class="commerce-product-layout">
<section class="commerce-product-gallery" aria-label="Изображения на продукта" data-commerce-gallery>
{% set image = product.images|first %}
{% if image %}<a class="commerce-main-image" href="{{ image.url }}" target="_blank" rel="noopener" data-commerce-open aria-label="Увеличи изображението"><span class="commerce-image-zoom" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6M10 7v6M7 10h6"/></svg></span><img src="{{ image.url }}" alt="{{ image.alt }}" title="{{ image.title }}" width="800" height="800" decoding="async" fetchpriority="high" data-commerce-main></a>
{% if product.images|length > 1 %}<div class="commerce-thumbnails" aria-label="Избери изображение">{% for image in product.images %}<button type="button" aria-label="Изображение {{ loop.index }}: {{ image.title }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}" data-commerce-thumbnail data-src="{{ image.url }}" data-alt="{{ image.alt }}" data-title="{{ image.title }}" data-caption="{{ image.caption }}" data-description="{{ image.description }}"><img src="{{ image.thumbnail_url ?: image.url }}" alt="" loading="lazy" decoding="async" width="80" height="80"></button>{% endfor %}</div>{% endif %}
<p class="commerce-image-caption" data-commerce-caption hidden>{{ image.caption }}</p><p class="commerce-muted" data-commerce-image-description hidden>{{ image.description }}</p>
{% else %}<div class="commerce-main-image commerce-image-placeholder">Няма изображение</div>{% endif %}
</section>
<section class="commerce-product-summary" aria-label="Информация за продукта">
<h1 class="commerce-product-title">{{ product.name }}</h1>
<div class="commerce-price{{ product.on_sale|default(false) ? ' commerce-price--sale' : '' }}">{% if product.on_sale|default(false) %}<div class="commerce-price-meta"><del class="commerce-regular-price" aria-label="Редовна цена">{{ product.regular_price }} <span class="commerce-price-currency">{{ product.currency }}</span></del><span class="commerce-sale-badge">Спестявате {{ product.discount_percent }}%</span></div><span class="commerce-price-label">Промоционална цена</span><ins class="commerce-sale-price" aria-label="Промоционална цена">{{ product.price }} <span class="commerce-price-currency">{{ product.currency }}</span></ins>{% else %}{{ product.price }} <span class="commerce-price-currency">{{ product.currency }}</span>{% endif %}</div>
{% if product.excerpt %}<p class="commerce-product-excerpt">{{ product.excerpt }}</p>{% endif %}
<p class="commerce-stock {{ product.available ? 'is-available' : '' }}">{{ product.available ? 'В наличност' : 'Изчерпан' }}</p>
{% if shipping_terms_url|default('') %}<p class="commerce-shipping-terms"><a href="{{ shipping_terms_url }}" target="_blank" rel="noopener">Условия за доставка</a></p>{% endif %}
<form class="commerce-purchase" data-commerce-purchase data-product-id="{{ product.id|default(0) }}" data-stock="{{ product.stock|default(0) }}">
<div class="commerce-purchase-controls">
<div class="commerce-quantity"><label for="commerce-product-quantity">Количество</label><div class="commerce-quantity-controls"><button type="button" data-quantity-change="-1" aria-label="Намали количеството" disabled><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/></svg></button><input id="commerce-product-quantity" name="quantity" type="number" min="1" max="{{ product.stock|default(0) }}" step="1" value="{{ product.available ? 1 : 0 }}" required inputmode="numeric" disabled><button type="button" data-quantity-change="1" aria-label="Увеличи количеството" disabled><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5v14"/></svg></button></div></div>
<div class="commerce-purchase-actions commerce-card-actions">
<button type="submit" class="commerce-purchase-button commerce-card-add" disabled><span class="commerce-add-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 7h14l1 14H4L5 7Z"/><path d="M9 7V5a3 3 0 0 1 6 0v2M9 14h6M12 11v6"/></svg></span><span class="commerce-card-action-label" data-commerce-cart-label>Добавяне</span></button>
<button type="button" class="commerce-quick-order-button commerce-card-quick-order" data-commerce-quick-order disabled aria-label="Бърза поръчка: {{ product.name }}" title="Бърза поръчка"><span class="commerce-quick-order-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/></svg></span><span class="commerce-card-action-label" data-commerce-cart-label>Бърза поръчка</span></button>
<button type="button" class="commerce-product-favorite" disabled data-commerce-favorite="{{ product.id|default(0) }}" data-product-name="{{ product.name }}" aria-pressed="false" aria-label="Добави {{ product.name }} към любими" title="Добави към любими"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/></svg></button>
</div>
</div>
<p class="commerce-muted" data-commerce-quantity-hint>Зареждане на наличността…</p><p class="commerce-purchase-status" data-commerce-purchase-status role="status" aria-live="polite"></p><noscript>За добавяне в количката е необходимо да включите JavaScript.</noscript>
</form>
<div class="commerce-product-meta">
{% if product.sku %}<p><span>Код на продукта:</span> {{ product.sku }}</p>{% endif %}
{% if product.categories %}<div class="commerce-product-categories"><span>Категории:</span>{% for category in product.categories %}<a href="/catalog/category/{{ category.slug|url_encode }}">{{ category.name }}</a>{% endfor %}</div>{% endif %}
</div>
{% if quick_view|default(false) %}<a class="commerce-back" href="/product/{{ product.slug|url_encode }}">Виж всички подробности →</a>{% else %}<a class="commerce-back" href="/catalog">← Обратно към каталога</a>{% endif %}
</section>
</div>
<section class="commerce-product-tabs" data-commerce-product-tabs aria-label="Подробности за продукта">
<div class="commerce-tab-buttons" hidden><button type="button" data-commerce-tab="description">Описание</button><button type="button" data-commerce-tab="information">Допълнителна информация</button>{% for tab in extra_tabs|default([]) %}<button type="button" data-commerce-tab="{{ tab.id }}">{{ tab.label }}</button>{% endfor %}</div>
<section id="commerce-product-description" data-commerce-panel="description" class="commerce-description"><h2>Описание</h2><div>{% if product.description %}{{ product.description|raw }}{% else %}<p>Няма добавено описание за този продукт.</p>{% endif %}</div></section>
<section id="commerce-product-information" data-commerce-panel="information" class="commerce-description"><h2>Допълнителна информация</h2><dl class="commerce-specifications">{% if product.sku %}<div><dt>Код на продукта</dt><dd>{{ product.sku }}</dd></div>{% endif %}<div><dt>Наличност</dt><dd>{{ product.available ? 'В наличност' : 'Изчерпан' }}</dd></div>{% if product.categories %}<div><dt>Категории</dt><dd>{% for category in product.categories %}{{ category.name }}{{ not loop.last ? ', ' : '' }}{% endfor %}</dd></div>{% endif %}</dl></section>
{% for tab in extra_tabs|default([]) %}<section id="commerce-product-{{ tab.id }}" data-commerce-panel="{{ tab.id }}" class="commerce-description">{{ tab.html|raw }}</section>{% endfor %}
</section>
</div>
